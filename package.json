    "expo": "~55.0.0",
    "expo-constants": "~55.0.7",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-router": "~55.0.5",
    "expo-status-bar": "~55.0.4",
    "i18next": "^25.7.3",
    "lucide-react-native": "^0.561.0",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.0",
